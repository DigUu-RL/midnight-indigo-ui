			"kind": "enum",
			"options": ["solid", "soft", "outline"]
		},
		{
			"name": "size",
			"type": "ChipSize",
			"required": false,
			"defaultValue": "'medium'",
			"description": "24 or 32 px high. Defaults to `'medium'`.",
			"native": false,
			"kind": "enum",
			"options": ["small", "medium"]
		},
		{
			"name": "icon",
			"type": "ReactNode",
			"required": false,
			"defaultValue": null,
