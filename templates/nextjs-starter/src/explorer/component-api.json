			"kind": "boolean",
			"options": []
		},
		{
			"name": "intent",
			"type": "SemanticIntent",
			"required": false,
			"defaultValue": "'default'",
			"description": "Defaults to `'default'`.",
			"native": false,
			"kind": "enum",
			"options": ["official", "brand", "default", "success", "warning", "error", "info"]
		},
		{
			"name": "variant",
			"type": "Appearance",
			"required": false,
			"defaultValue": "'ghost'",
			"description": "Defaults to `'ghost'`.",
