			"kind": "boolean",
			"options": []
		},
		{
			"name": "onDelete",
			"type": "() => void",
			"required": false,
			"defaultValue": null,
			"description": "Adds a delete button after the label.",
			"native": false,
			"kind": "other",
			"options": []
