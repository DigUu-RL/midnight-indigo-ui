	"Chip": [
		{
			"name": "label",
			"type": "ReactNode",
			"required": true,
			"defaultValue": null,
			"description": "Visible text; it is also the accessible name of the chip and of its button.",
			"native": false,
			"kind": "node",
			"options": []
		},
		{
			"name": "intent",
			"type": "SemanticIntent",
			"required": false,
			"defaultValue": "'default'",
			"description": "Meaning of the attribute or status. Defaults to `'default'`.",
