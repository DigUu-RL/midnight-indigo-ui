		{
			"name": "deleteLabel",
			"type": "string",
			"required": false,
			"defaultValue": null,
			"description": "Name of the delete button, e.g. `'Remove Status: open'`; needs `onDelete`.",
			"native": false,
			"kind": "string",
			"options": []
