{
	"name": "@midnight-indigo/ui",
	"version": "0.0.0",
	"description": "Midnight Indigo: UI — dark-only React + TypeScript component library.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"imports": {
		"#src/*": "./src/*",
		"#test/*": "./test/*",
		"#scripts/*": "./scripts/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tokens": {
			"types": "./dist/tokens/index.d.ts",
			"default": "./dist/tokens/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"default": "./dist/theme/index.js"
		},
		"./buttons": {
			"types": "./dist/buttons/index.d.ts",
			"default": "./dist/buttons/index.js"
		},
		"./forms": {
			"types": "./dist/forms/index.d.ts",
			"default": "./dist/forms/index.js"
		},
		"./forms/date-pickers": {
			"types": "./dist/forms/date-pickers/index.d.ts",
			"default": "./dist/forms/date-pickers/index.js"
		},
		"./forms/react-hook-form": {
			"types": "./dist/forms/react-hook-form/index.d.ts",
			"default": "./dist/forms/react-hook-form/index.js"
		},
		"./feedback": {
			"types": "./dist/feedback/index.d.ts",
			"default": "./dist/feedback/index.js"
		},
		"./layout": {
			"types": "./dist/layout/index.d.ts",
			"default": "./dist/layout/index.js"
		},
		"./navigation": {
			"types": "./dist/navigation/index.d.ts",
			"default": "./dist/navigation/index.js"
		},
		"./data-display": {
			"types": "./dist/data-display/index.d.ts",
			"default": "./dist/data-display/index.js"
		},
		"./charts": {
			"types": "./dist/charts/index.d.ts",
			"default": "./dist/charts/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"default": "./dist/i18n/index.js"
		},
		"./dashboard": {
			"types": "./dist/dashboard/index.d.ts",
			"default": "./dist/dashboard/index.js"
		},
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"default": "./dist/icons/index.js"
		},
		"./code": {
			"types": "./dist/code/index.d.ts",
			"default": "./dist/code/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate:tokens": "node scripts/generate-token-artifacts.ts",
		"generate:glyphs": "node scripts/generate-glyphs.ts",
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:performance": "vitest run --config vitest.performance.config.ts",
		"check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./styles.css"
	},
	"peerDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@mui/material": "^9.5.0",
		"@mui/x-date-pickers": "^9.14.0",
		"date-fns": "^4.0.0",
		"echarts": "^6.0.0",
		"i18next": "^26.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.55.0",
		"react-i18next": "^17.0.0",
		"shiki": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@mui/x-date-pickers": {
			"optional": true
		},
		"date-fns": {
			"optional": true
		},
		"echarts": {
			"optional": true
		},
		"i18next": {
			"optional": true
		},
		"react-hook-form": {
			"optional": true
		},
		"react-i18next": {
			"optional": true
		},
		"shiki": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "catalog:",
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@iconify-json/tabler": "catalog:",
		"@mui/material": "catalog:",
		"@mui/x-date-pickers": "catalog:",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"axe-core": "catalog:",
		"date-fns": "catalog:",
		"echarts": "catalog:",
		"i18next": "catalog:",
		"jsdom": "catalog:",
		"publint": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-hook-form": "catalog:",
		"react-i18next": "catalog:",
		"shiki": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
