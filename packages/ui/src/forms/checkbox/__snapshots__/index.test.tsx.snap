// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Checkbox > keeps the same visual states (regression) 1`] = `
[
  "&{-webkit-appearance:none;-moz-appearance:none;-ms-appearance:none;appearance:none;box-sizing:border-box;display:inline-grid;place-content:center;-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0;margin:0;border-width:2px;border-style:solid;border-color:var(--mi-border-strong);background-color:var(--mi-surface-sunken);cursor:pointer;transition-property:background-color,border-color,color,box-shadow;transition-duration:var(--mi-motion-duration-fast);transition-timing-function:var(--mi-motion-easing-standard);width:1.125rem;height:1.125rem;border-radius:var(--mi-radius-small);}",
  "&::before{content:"";box-sizing:border-box;}",
  "&:checked,&:indeterminate{background-color:var(--mi-intent-brand-main);border-color:var(--mi-intent-brand-main);}",
  "&:checked::before{width:0.3rem;height:0.6rem;margin-block-start:-0.1rem;border-style:solid;border-color:var(--mi-intent-brand-contrast-text);border-width:0 2px 2px 0;-webkit-transform:rotate(45deg);-moz-transform:rotate(45deg);-ms-transform:rotate(45deg);transform:rotate(45deg);}",
  "&:indeterminate::before{width:0.6rem;height:2px;background-color:var(--mi-intent-brand-contrast-text);}",
  "&:focus-visible{outline:var(--mi-focus-width) solid var(--mi-focus-ring);outline-offset:var(--mi-focus-offset);}",
  "&:hover:not(:disabled){border-color:var(--mi-text-muted);}",
  "&:is(:checked, :indeterminate):hover:not(:disabled){background-color:var(--mi-intent-brand-hover);border-color:var(--mi-intent-brand-hover);}",
  "&:disabled,&:disabled:is(:checked, :indeterminate){border-color:var(--mi-state-disabled-border);background-color:var(--mi-state-disabled-surface);cursor:not-allowed;}",
  "&:disabled:checked::before{border-color:var(--mi-state-disabled-text);}",
  "&:disabled:indeterminate::before{background-color:var(--mi-state-disabled-text);}",
]
`;
