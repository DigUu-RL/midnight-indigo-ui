    "&{box-sizing:border-box;display:-webkit-inline-box;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;width:auto;-webkit-align-items:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;-webkit-justify-content:center;justify-content:center;min-height:var(--mi-control-height-medium);margin:0;padding-block:var(--mi-spacing-1);border-width:1px;border-style:solid;border-radius:var(--mi-radius-control);text-align:center;-webkit-text-decoration:none;text-decoration:none;cursor:pointer;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;font-family:var(--mi-typography-label-font-family);font-size:var(--mi-typography-label-font-size);font-weight:var(--mi-typography-label-font-weight);line-height:var(--mi-typography-label-line-height);letter-spacing:var(--mi-typography-label-letter-spacing);text-transform:var(--mi-typography-label-text-transform);gap:var(--mi-spacing-2);padding-inline:var(--mi-spacing-4);transition-property:background-color,border-color,color,box-shadow;transition-duration:var(--mi-motion-duration-fast);transition-timing-function:var(--mi-motion-easing-standard);background-color:var(--mi-intent-success-main);border-color:var(--mi-intent-success-border);color:var(--mi-intent-success-contrast-text);}",
    "&:hover:not(:disabled):not([aria-disabled="true"]){background-color:var(--mi-intent-success-hover);border-color:var(--mi-intent-success-hover);}",
    "&:active:not(:disabled):not([aria-disabled="true"]){background-color:var(--mi-intent-success-pressed);border-color:var(--mi-intent-success-pressed);}",
    "&:focus-visible{outline:var(--mi-focus-width) solid var(--mi-focus-ring);outline-offset:var(--mi-focus-offset);}",
    "&[aria-busy="true"]{cursor:progress;}",
    "&:disabled,&[aria-disabled="true"]:not([aria-busy="true"]){background-color:var(--mi-state-disabled-surface);border-color:var(--mi-state-disabled-border);color:var(--mi-state-disabled-text);cursor:not-allowed;}",
  ],
  "warning solid": [
    "&{box-sizing:border-box;display:-webkit-inline-box;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;width:auto;-webkit-align-items:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;-webkit-justify-content:center;justify-content:center;min-height:var(--mi-control-height-medium);margin:0;padding-block:var(--mi-spacing-1);border-width:1px;border-style:solid;border-radius:var(--mi-radius-control);text-align:center;-webkit-text-decoration:none;text-decoration:none;cursor:pointer;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;font-family:var(--mi-typography-label-font-family);font-size:var(--mi-typography-label-font-size);font-weight:var(--mi-typography-label-font-weight);line-height:var(--mi-typography-label-line-height);letter-spacing:var(--mi-typography-label-letter-spacing);text-transform:var(--mi-typography-label-text-transform);gap:var(--mi-spacing-2);padding-inline:var(--mi-spacing-4);transition-property:background-color,border-color,color,box-shadow;transition-duration:var(--mi-motion-duration-fast);transition-timing-function:var(--mi-motion-easing-standard);background-color:var(--mi-intent-warning-main);border-color:var(--mi-intent-warning-border);color:var(--mi-intent-warning-contrast-text);}",
    "&:hover:not(:disabled):not([aria-disabled="true"]){background-color:var(--mi-intent-warning-hover);border-color:var(--mi-intent-warning-hover);}",
    "&:active:not(:disabled):not([aria-disabled="true"]){background-color:var(--mi-intent-warning-pressed);border-color:var(--mi-intent-warning-pressed);}",
    "&:focus-visible{outline:var(--mi-focus-width) solid var(--mi-focus-ring);outline-offset:var(--mi-focus-offset);}",
    "&[aria-busy="true"]{cursor:progress;}",
    "&:disabled,&[aria-disabled="true"]:not([aria-busy="true"]){background-color:var(--mi-state-disabled-surface);border-color:var(--mi-state-disabled-border);color:var(--mi-state-disabled-text);cursor:not-allowed;}",
  ],
}
`;
