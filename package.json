{
	"name": "midnight-indigo-ui-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test \"scripts/**/*.test.ts\" && pnpm -r run test",
		"test:performance": "pnpm --filter @midnight-indigo/ui run test:performance",
		"test:browser": "pnpm --filter @midnight-indigo/browser-tests run test:browser",
		"check:package": "pnpm --filter @midnight-indigo/ui run check:package",
		"check:source": "node scripts/check-source-clean.ts",
		"check:licenses": "node scripts/check-licenses.ts",
		"check:bundle": "node scripts/check-bundle-size.ts",
		"create:starter": "node templates/nextjs-starter/scripts/create-starter.ts",
		"check:starter": "node templates/nextjs-starter/scripts/check-generated-starter.ts",
		"update:icon-sets": "node scripts/update-icon-sets.ts",
		"check": "node scripts/check.ts",
		"show:preview": "pnpm --filter @midnight-indigo/nextjs-starter dev"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@midnight-indigo/node-aliases": "workspace:*",
		"@stylistic/eslint-plugin": "catalog:",
		"@types/estree": "catalog:",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"jiti": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:"
	}
}
